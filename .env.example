# ==============================================================================
# SecureFileShare - Environment Variables Configuration Template (.env.example)
# WHAT: Documents all environment variables required by SecureFileShare microservices.
# WHY: CRITICAL SECURITY REQUIREMENT: All hardcoded defaults and fallbacks for secrets
#      have been removed from source code and application.yml files. Every secret below
#      MUST be supplied via environment variables, otherwise services will fail startup.
# ==============================================================================

# PostgreSQL Database Configuration
# POSTGRES_PASSWORD is REQUIRED (no fallback in application.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sfs_admin
POSTGRES_PASSWORD=sfs_secure_pass_2026

# MinIO S3 Object Storage Configuration
# MINIO_ROOT_PASSWORD is REQUIRED by file-service (no fallback in application.yml)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_pass_2026
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=secure-files

# Redis In-Memory Cache and Token Blacklist Configuration
# REDIS_PASSWORD is REQUIRED by auth-service (no fallback in application.yml)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass_2026

# Microservice HTTP Ports
AUTH_SERVICE_PORT=8081
FILE_SERVICE_PORT=8082
SHARE_SERVICE_PORT=8083
AUDIT_SERVICE_PORT=8084

# Security: JWT HMAC-SHA256 Signing Configuration
# JWT_SECRET is REQUIRED (minimum 32 characters / 256 bits; no fallback in application.yml)
JWT_SECRET=super_secret_jwt_signing_key_secure_file_share_2026_at_least_32_chars!
JWT_EXPIRATION_MS=900000

# Security: Initial Administrator Credentials (seeded only once on clean database setup)
# ADMIN_INITIAL_PASSWORD, ADMIN_INITIAL_USERNAME, ADMIN_INITIAL_EMAIL are REQUIRED (no fallback in AdminSeeder)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@securefileshare.com
ADMIN_INITIAL_PASSWORD=Admin@SecurePass2026!
