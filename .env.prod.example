# ==============================================================================
# File: .env.prod.example
# WHAT: Production environment variable template for SecureFileShare.
# WHY: Documents all required runtime secrets and configuration values.
#
# SECURITY DIRECTIVE:
# Copy this file to .env on the deployment server:
#   cp .env.prod.example .env
#   chmod 600 .env
# Generate cryptographically strong random secrets for production using:
#   openssl rand -hex 32
# NEVER commit the filled .env file into Git repository tracking.
# ==============================================================================

# ------------------------------------------------------------------------------
# Ingress & Domain Configuration
# ------------------------------------------------------------------------------
# Fully Qualified Domain Name (FQDN) pointed to your server IP via DNS A/AAAA record
# Why: Caddy requires a valid domain to provision automatic HTTPS TLS certificates
SERVER_DOMAIN=sfs.yourdomain.com

# Public Host Ports for Caddy reverse proxy
# Why: Port 8443 is used to avoid collision with existing Wazuh Dashboard listening on port 443
HTTP_PORT=80
HTTPS_PORT=8443

# ------------------------------------------------------------------------------
# Container Image Registry & Tags
# ------------------------------------------------------------------------------
# GitHub Container Registry URL and repository path
IMAGE_REGISTRY=ghcr.io
IMAGE_REPO=ayu-lodhi/securefileshare

# Production deployment release tag (updated automatically by GitHub Actions deploy workflow)
# Why: Pinned SHA tag ensures deterministic, immutable deployments and predictable rollbacks
IMAGE_TAG=latest

# ------------------------------------------------------------------------------
# PostgreSQL 16 Database Configuration
# ------------------------------------------------------------------------------
# Database superuser name for PostgreSQL cluster
POSTGRES_USER=sfs_prod_admin

# Database password (generate via: openssl rand -base64 32)
# Why: High-entropy secret blocks brute-force database credential guessing
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD_MIN_32_CHARS

# ------------------------------------------------------------------------------
# Redis 7 In-Memory Cache & Token Store
# ------------------------------------------------------------------------------
# Redis authentication password (generate via: openssl rand -base64 32)
# Why: Protects against unauthorized commands and protects cached rate-limiting metrics
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_MIN_32_CHARS

# ------------------------------------------------------------------------------
# MinIO S3-Compatible Object Storage
# ------------------------------------------------------------------------------
# MinIO root access key username (generate via: openssl rand -hex 16)
MINIO_ROOT_USER=sfs_minio_admin

# MinIO root secret key password (generate via: openssl rand -base64 32)
# Why: Protects ciphertext object storage buckets from unauthorized S3 API calls
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD_MIN_32_CHARS

# Bucket name dedicated to storing client-side AES-256-GCM encrypted ciphertext chunks
MINIO_BUCKET_NAME=sfs-encrypted-files

# ------------------------------------------------------------------------------
# Application Security & Cryptographic Tokens
# ------------------------------------------------------------------------------
# HMAC-SHA256 Secret Key for signing and verifying JWT authentication tokens
# MUST be at least 256 bits / 64 hex characters (generate via: openssl rand -hex 32)
# Why: Guarantees cryptographic resistance against HMAC forgery attacks
JWT_SECRET=CHANGE_ME_JWT_SECRET_64_HEX_CHARS_EXACTLY_GENERATED_BY_OPENSSL

# JWT token expiration time in milliseconds (default: 15 minutes = 900,000 ms)
# Why: Short token validity limits attack window if an access token is leaked
JWT_EXPIRATION_MS=900000
